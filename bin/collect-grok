#!/usr/bin/python3
"""Print a Grok usage record for the agents panel.

The plan and the allowance come from the same endpoints Grok's own /usage
reads, using the sign-in `grok login` already stored in ~/.grok/auth.json.
Token totals stay with bin/usage-index; this only adds the plan, the limit
windows and any prepaid balance. Run by bin/usage-update, which writes the
record to disk.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any


AGENT_ID = "grok"
AGENT_NAME = "Grok"
SOURCE = "beforeugone.agents/grok"
AUTH_HELP = "Run `grok login` to restore authoritative usage."
DEFAULT_PROXY = "https://cli-chat-proxy.grok.com/v1"
PROBE_MIN_INTERVAL_SECONDS = 15

# Monthly sticker prices from grok.com/plans (2026-10), not what the API
# returns. Annual plans cost less, but the endpoint does not say which
# cycle this account is on, so they are not converted here.
PLAN_NAMES = {
  "supergrokheavy": "grok · heavy 300$",
  "supergrokplus": "grok · plus 100$",
  "supergroklite": "grok · lite 10$",
  "supergrokpro": "grok · pro",
  "supergrok": "grok · 30$",
  "grokpro": "grok · pro",
  # Display "X Premium+" compacts to xpremium+; the tier code to xpremiumplus.
  "xpremiumplus": "grok · premium+",
  "xpremium+": "grok · premium+",
  "xpremium": "grok · premium",
  "xbasic": "grok · basic",
  "free": "grok · free",
}

PRODUCT_NAMES = {
  "PRODUCT_GROK_BUILD": "Grok Build",
  "GrokBuild": "Grok Build",
  "PRODUCT_GROK_CHAT": "Grok Chat",
  "GrokChat": "Grok Chat",
  "PRODUCT_GROK_BOT": "Grok Bot",
  "GrokBot": "Grok Bot",
}

STAT_KEYS = (
  "todayPrompts", "todaySessions", "todayTotalTokens", "todayTokensByModel",
  "recentDays", "totalPrompts", "totalSessions", "activeDays", "activeDates",
  "modelUsage", "hasLocalStats", "hasPromptStats",
)


def grok_home() -> Path:
  return Path(os.environ.get("GROK_HOME") or (Path.home() / ".grok")).expanduser()


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def usage_path() -> Path:
  state = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))
  return state / "omarchy" / "agents" / "usage" / "grok.json"


def read_json(path: Path) -> dict[str, Any]:
  try:
    parsed = json.loads(path.read_text(encoding="utf-8"))
  except (OSError, json.JSONDecodeError):
    return {}
  return parsed if isinstance(parsed, dict) else {}


def write_json(path: Path, payload: dict[str, Any]) -> None:
  fd, name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(name)
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(payload, handle, ensure_ascii=False)
      handle.write("\n")
    os.replace(tmp, path)
  except OSError:
    tmp.unlink(missing_ok=True)
    raise


def fresh_json(path: Path, max_age: float) -> dict[str, Any]:
  try:
    age = time.time() - path.stat().st_mtime
  except OSError:
    return {}
  # max_age <= 0 is a miss, which is how --force skips the last reading.
  if max_age <= 0 or age > max_age:
    return {}
  return read_json(path)


def proxy_base() -> str:
  origin = ""
  cached = read_json(grok_home() / "settings_cache.json")
  payload = cached.get("payload")
  if isinstance(payload, str):
    try:
      payload = json.loads(payload)
    except json.JSONDecodeError:
      payload = None
  if isinstance(payload, dict) and isinstance(payload.get("origin"), str):
    origin = payload["origin"].strip().rstrip("/")
  if origin.startswith("https://"):
    return origin
  return DEFAULT_PROXY


def client_version() -> str:
  version = read_json(grok_home() / "version.json").get("version")
  return version.strip() if isinstance(version, str) and version.strip() else "0.0.0"


def auth_entry() -> dict[str, Any] | None:
  store = read_json(grok_home() / "auth.json")
  chosen: dict[str, Any] | None = None
  chosen_expiry = ""
  for value in store.values():
    if not isinstance(value, dict) or not value.get("key") or not value.get("user_id"):
      continue
    expiry = str(value.get("expires_at") or "")
    if chosen is None or expiry > chosen_expiry:
      chosen, chosen_expiry = value, expiry
  return chosen


def request_json(url: str, auth: dict[str, Any]) -> Any:
  req = urllib.request.Request(url, headers={
    "Authorization": "Bearer " + str(auth["key"]),
    "X-XAI-Token-Auth": "xai-grok-cli",
    "x-userid": str(auth["user_id"]),
    "x-grok-client-version": client_version(),
    "Accept": "application/json",
  })
  with urllib.request.urlopen(req, timeout=15) as response:
    payload = json.loads(response.read().decode("utf-8", errors="replace"))
  return payload


def plan_name(tier: str) -> str:
  compact = re.sub(r"[^a-z0-9+]", "", tier.lower())
  if not compact:
    return ""
  # Whole-key match, longest first, so "supergrok" cannot claim "supergrokheavy".
  for key in sorted(PLAN_NAMES, key=len, reverse=True):
    if compact == key:
      return PLAN_NAMES[key]
  for stem in ("supergrok", "grok"):
    if compact.startswith(stem) and len(compact) > len(stem):
      return "grok · " + compact[len(stem):]
  return re.sub(r"(?<=[a-z])(?=[A-Z])", " ", tier).replace("_", " ").strip()


def choose_plan(display: Any, tier: Any) -> str:
  # Settings carry the name /usage shows ("SuperGrok Heavy"). The user
  # endpoint carries the tier code ("SuperGrokPro") when settings omit it.
  # Whichever is present is mapped; the raw string is not the label.
  raw = ""
  if isinstance(display, str) and display.strip():
    raw = display.strip()
  elif isinstance(tier, str) and tier.strip():
    raw = tier.strip()
  return plan_name(raw) if raw else ""


def meter_title(plan: str) -> str:
  """Drop a leading "grok" from a limits-row title.

  The merged page prefixes every row with the agent name. A title that
  already starts with grok would read "Grok · grok · heavy 300$".
  """
  text = plan.strip()
  lower = text.lower()
  for prefix in ("grok · ", "grok "):
    if lower.startswith(prefix):
      rest = text[len(prefix):].strip()
      return rest or text
  return text


def product_name(raw: Any) -> str:
  text = str(raw or "").strip()
  if text in PRODUCT_NAMES:
    return PRODUCT_NAMES[text]
  spaced = re.sub(r"(?<=[a-z])(?=[A-Z])", " ", text.replace("PRODUCT_", "").replace("_", " "))
  return spaced.strip() or "Grok"


def as_fraction(value: Any) -> float | None:
  """A billing percentage (0–100, and above 100 once on-demand starts) as a 0–1 share."""
  if isinstance(value, bool) or not isinstance(value, (int, float)):
    return None
  return max(0.0, float(value)) / 100.0


def cents(node: Any) -> float | None:
  if not isinstance(node, dict):
    return None
  val = node.get("val")
  if isinstance(val, bool) or not isinstance(val, (int, float)):
    return None
  return float(val) / 100.0


def window_of(config: dict[str, Any]) -> tuple[str, str] | None:
  period = config.get("currentPeriod") if isinstance(config.get("currentPeriod"), dict) else {}
  kind = str(period.get("type") or "")
  end = str(period.get("end") or config.get("billingPeriodEnd") or "")
  if "MONTH" in kind:
    return "Monthly", end
  if "WEEK" in kind:
    return "Weekly", end
  if "creditUsagePercent" in config or config.get("isUnifiedBillingUser") is True:
    return "Weekly", end
  return None


def limit_row(label: str, title: str, fraction: float, resets_at: str) -> dict[str, Any]:
  return {"label": label, "title": title, "percent": fraction, "resetsAt": resets_at}


def parse_billing(payload: dict[str, Any], plan: str) -> dict[str, Any]:
  """Limits and balance from GET /billing?format=credits.

  A confirmed weekly period omits creditUsagePercent when the share is zero:
  the credits API drops zero-valued fields. That is a real 0%, not a missing
  reading. A field that is present and null is left unread.
  """
  config = payload.get("config") if isinstance(payload.get("config"), dict) else {}
  window = window_of(config)
  limits: list[dict[str, Any]] = []
  fraction = as_fraction(config.get("creditUsagePercent")) if "creditUsagePercent" in config else None
  if fraction is None and window and "creditUsagePercent" not in config:
    fraction = 0.0
  if window and fraction is not None:
    label, resets_at = window
    limits.append(limit_row(label, plan or label, fraction, resets_at))

  resets_at = window[1] if window else ""
  products = config.get("productUsage")
  if isinstance(products, list):
    for row in products:
      if not isinstance(row, dict) or "usagePercent" not in row:
        continue
      share = as_fraction(row.get("usagePercent"))
      if share is None:
        continue
      name = product_name(row.get("product"))
      limits.append(limit_row(name, meter_title(name), share, resets_at))

  balance = None
  prepaid = cents(config.get("prepaidBalance"))
  if prepaid is not None and prepaid > 0:
    balance = {
      "remaining": prepaid,
      "funded": prepaid,
      "spent": 0.0,
      "currency": "USD",
      "estimated": False,
    }

  cap = cents(config.get("onDemandCap"))
  used = cents(config.get("onDemandUsed"))
  if cap is not None and cap > 0 and used is not None:
    limits.append(limit_row("On-demand", "On-demand", used / cap, resets_at))

  return {"limits": limits, "balance": balance}


def cached_limits() -> dict[str, Any]:
  cached = read_json(cache_root() / "grok-limits.json")
  return cached if isinstance(cached.get("limits"), list) or cached.get("tierLabel") else {}


def preserved_stats() -> dict[str, Any]:
  old = read_json(usage_path())
  stats = {key: old[key] for key in STAT_KEYS if key in old}
  stats.setdefault("hasLocalStats", False)
  stats.setdefault("hasPromptStats", False)
  return stats


def failure(status: str, help_text: str, retry: bool = False) -> dict[str, Any]:
  # Keep the last reading. The status says this attempt did not replace it,
  # and fetchedAtMs stays when that reading was actually taken.
  fallback = cached_limits()
  result = {
    "limits": fallback.get("limits") or [],
    "balance": fallback.get("balance"),
    "tierLabel": str(fallback.get("tierLabel") or ""),
    "usageStatusText": status,
    "authHelpText": help_text,
    "fetchedAtMs": fallback.get("fetchedAtMs") or int(time.time() * 1000),
  }
  if retry:
    result["retryAdvised"] = True
  try:
    write_json(cache_root() / "grok-limits.json", result)
  except OSError:
    pass
  return result


def collect_limits(force: bool) -> dict[str, Any]:
  cache = cache_root() / "grok-limits.json"
  recent = fresh_json(cache, 0 if force else PROBE_MIN_INTERVAL_SECONDS)
  if recent and (isinstance(recent.get("limits"), list) or recent.get("tierLabel")) and not recent.get("usageStatusText"):
    return recent

  auth = auth_entry()
  if not auth:
    return failure("Waiting for auth", AUTH_HELP)

  base = proxy_base()
  try:
    user = request_json(base + "/user?include=subscription", auth)
    settings = request_json(base + "/settings", auth)
    billing = request_json(base + "/billing?format=credits", auth)
  except urllib.error.HTTPError as error:
    if error.code in {401, 403}:
      fallback = cached_limits()
      help_text = AUTH_HELP + (" Showing the last known limits." if fallback.get("limits") else "")
      return failure("Sign-in expired", help_text)
    return failure(
      "Grok limits unavailable",
      f"Grok's usage endpoint returned status {error.code}. Local Grok stats are still shown.",
      retry=True,
    )
  except Exception:
    return failure(
      "Grok limits unavailable",
      "Couldn't reach Grok's usage endpoint. Local Grok stats are still shown.",
      retry=True,
    )

  if not isinstance(user, dict) or not isinstance(billing, dict):
    return failure("Grok limits unavailable", "Grok returned an unexpected usage response.", retry=True)

  nested = settings.get("settings") if isinstance(settings, dict) else None
  remote = nested if isinstance(nested, dict) else (settings if isinstance(settings, dict) else {})
  plan = choose_plan(remote.get("subscription_tier_display") or remote.get("subscription_tier"), user.get("subscriptionTier"))
  parsed = parse_billing(billing, meter_title(plan) or plan)
  result = {
    "limits": parsed["limits"],
    "balance": parsed["balance"],
    "tierLabel": plan,
    "usageStatusText": "",
    "authHelpText": AUTH_HELP,
    "fetchedAtMs": int(time.time() * 1000),
  }
  write_json(cache, result)
  return result


def build_record(limits: dict[str, Any]) -> dict[str, Any]:
  stats = preserved_stats()
  record: dict[str, Any] = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "source": SOURCE,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": bool(limits.get("limits")) or bool(limits.get("tierLabel")) or bool(stats.get("hasLocalStats")),
    "tierLabel": str(limits.get("tierLabel") or ""),
    "usageStatusText": str(limits.get("usageStatusText") or ""),
    "authHelpText": str(limits.get("authHelpText") or AUTH_HELP),
    "limits": limits.get("limits") or [],
  }
  if limits.get("balance"):
    record["balance"] = limits["balance"]
  if limits.get("retryAdvised"):
    record["retryAdvised"] = True
  record.update(stats)
  return record


def self_test() -> None:
  heavy = {
    "config": {
      "currentPeriod": {
        "type": "USAGE_PERIOD_TYPE_WEEKLY",
        "start": "2026-10-11T04:06:33.979847+00:00",
        "end": "2026-10-18T04:06:33.979847+00:00",
      },
      "onDemandCap": {"val": 0},
      "onDemandUsed": {"val": 0},
      "isUnifiedBillingUser": True,
      "prepaidBalance": {"val": 0},
    }
  }
  parsed = parse_billing(heavy, "SuperGrok Heavy")
  assert parsed["limits"] == [{
    "label": "Weekly",
    "title": "SuperGrok Heavy",
    "percent": 0.0,
    "resetsAt": "2026-10-18T04:06:33.979847+00:00",
  }], parsed
  assert parsed["balance"] is None

  split = {
    "config": {
      "creditUsagePercent": 51,
      "currentPeriod": {"type": "USAGE_PERIOD_TYPE_WEEKLY", "end": "2026-09-02T23:45:03Z"},
      "productUsage": [
        {"product": "GrokBuild", "usagePercent": 49},
        {"product": "GrokChat", "usagePercent": 2},
      ],
      "prepaidBalance": {"val": 1250},
      "onDemandCap": {"val": 5000},
      "onDemandUsed": {"val": 300},
    }
  }
  parsed = parse_billing(split, "SuperGrok")
  assert [row["title"] for row in parsed["limits"]] == ["SuperGrok", "Build", "Chat", "On-demand"]
  assert parsed["limits"][0]["percent"] == 0.51
  assert parsed["limits"][1]["percent"] == 0.49
  assert abs(parsed["limits"][3]["percent"] - 0.06) < 1e-9
  assert parsed["balance"]["remaining"] == 12.5

  assert choose_plan("SuperGrok Heavy", "SuperGrokPro") == "grok · heavy 300$"
  assert meter_title("grok · heavy 300$") == "heavy 300$"
  assert meter_title("Grok Build") == "Build"
  assert meter_title("grok · 30$") == "30$"
  assert meter_title("On-demand") == "On-demand"
  assert choose_plan(None, "SuperGrokPro") == "grok · pro"
  assert choose_plan("SuperGrok Plus", None) == "grok · plus 100$"
  assert choose_plan(None, "SuperGrokLite") == "grok · lite 10$"
  assert choose_plan("SuperGrok", "") == "grok · 30$"
  assert choose_plan("Free", None) == "grok · free"
  assert choose_plan("X Premium+", None) == "grok · premium+"
  assert choose_plan("", "") == ""
  monthly = parse_billing({"config": {"creditUsagePercent": 10, "currentPeriod": {"type": "USAGE_PERIOD_TYPE_MONTHLY", "end": "2026-11-01T00:00:00Z"}}}, "")
  assert monthly["limits"][0]["label"] == "Monthly"
  assert monthly["limits"][0]["title"] == "Monthly"
  assert parse_billing({"config": {"creditUsagePercent": None}}, "SuperGrok")["limits"] == []


def main() -> None:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  parser.add_argument("--self-test", action="store_true")
  args = parser.parse_args()
  if args.self_test:
    self_test()
    return
  print(json.dumps(build_record(collect_limits(args.force)), separators=(",", ":")))


if __name__ == "__main__":
  main()
